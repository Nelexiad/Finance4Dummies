# Application
APP_NAME=Finance4Dummies
APP_ENV=development
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
ALLOW_PUBLIC_REGISTRATION=true

# Security (change JWT_SECRET_KEY before deploying to production!)
JWT_SECRET_KEY=change-me-in-production-use-at-least-32-random-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL + TimescaleDB
POSTGRES_USER=finance
POSTGRES_PASSWORD=finance_dev_password
POSTGRES_DB=finance4dummies
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://finance:finance_dev_password@postgres:5432/finance4dummies

# Redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Frontend
VITE_API_BASE_URL=http://localhost:8000
